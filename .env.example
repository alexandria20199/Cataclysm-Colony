# Hosted PostgreSQL connection string. A local database is intentionally not used.
NODE_ENV=production
PORT=3000
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Generate random values of at least 32 bytes; never commit the real values.
SESSION_SECRET=replace-with-a-long-random-secret
PASSWORD_CODE_SECRET=replace-with-another-long-random-secret

# Password verification email through Resend (https://resend.com).
RESEND_API_KEY=re_...
EMAIL_FROM="Cataclysm Colony <no-reply@your-verified-domain.example>"

# Persistent user/article/announcement images through Cloudinary.
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
CLOUDINARY_FOLDER=cataclysm-colony

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEWSROOM_CHAT_KEY=replace-with-base64-encoded-32-byte-key
